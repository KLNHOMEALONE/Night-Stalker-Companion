<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- На этой машине SDK 7.0.317, поэтому только net7.0. Для MAUI на net8.0
         просто верните в список net8.0: коду нужны только HttpClient, Regex и System.Text.Json. -->
