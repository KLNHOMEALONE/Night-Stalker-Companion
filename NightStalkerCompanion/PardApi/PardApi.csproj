<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- На этой машине два SDK: /usr/local/share/dotnet — это 7.0.317, он же стоит
         в PATH первым; ~/.dotnet — 10.0.404. Поэтому перед сборкой ~/.dotnet нужен
         в PATH, иначе 7.0.317 отвечает на net10.0 непонятным NETSDK1045:
           export DOTNET_ROOT=$HOME/.dotnet && export PATH="$HOME/.dotnet:$PATH"
         Коду от фреймворка нужны только HttpClient, Regex и System.Text.Json. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
