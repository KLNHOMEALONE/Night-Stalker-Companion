<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An integration check for the service layer, run against tools/mock_scope.py.

    It exists because the thing it checks cannot be checked from a unit test and should not
    be checked by hand: which group a reticle read belongs to, and whether the app still
    knows a group after the device stopped showing it. That needs a device, an HTTP round
    trip, and a write that switches the active group — and most of this project's users do
    not have the scope in their hands while they code.

    It links the app's own service files rather than copying them: they depend on nothing but
    PardApi, so the code under test here is the code the app runs, and if it ever grows a MAUI
    dependency this project stops compiling, which is the honest way to find that out.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScopeScenario</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../PardApi/PardApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../NightStalkerCompanion/Services/IPardService.cs" Link="Services/IPardService.cs" />
    <Compile Include="../../NightStalkerCompanion/Services/PardService.cs" Link="Services/PardService.cs" />
    <Compile Include="../../NightStalkerCompanion/Services/ReadModel.cs" Link="Services/ReadModel.cs" />
    <Compile Include="../../NightStalkerCompanion/Services/ReticleInfo.cs" Link="Services/ReticleInfo.cs" />
  </ItemGroup>

</Project>
