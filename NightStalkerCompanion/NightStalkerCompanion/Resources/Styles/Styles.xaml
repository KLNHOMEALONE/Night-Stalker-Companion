<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Typography follows ui/prototype/index.html: sans is the iOS system face
         (San Francisco), mono is Menlo. The mock-up writes letter-spacing in em;
         MAUI measures it in points, so CharacterSpacing = em x FontSize. -->

    <x:String x:Key="MonoFont">Menlo</x:String>

    <!-- ── headings ──────────────────────────────────────────────────────── -->

    <!-- h2: 12 / 600 / +0.14em / uppercase, Ink2 -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.68" />
        <Setter Property="TextColor" Value="{StaticResource Ink2}" />
    </Style>

    <!-- h4: screen title, 15 / 600 -->
    <Style x:Key="ScreenTitle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <!-- ── text ──────────────────────────────────────────────────────────── -->

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextColor" Value="{StaticResource Ink2}" />
    </Style>

    <!-- .writebar p / .alert: small explanatory text -->
    <Style x:Key="Note" TargetType="Label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{StaticResource Ink3}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <!-- ── monospaced numbers ────────────────────────────────────────────── -->

    <Style x:Key="MonoValue" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- .bar: the status strip above the content, 11 / 500, Ink2 -->
    <Style x:Key="BarText" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource Ink2}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- .status i: caption of an instrument cell, 9.5 / +0.08em / uppercase -->
    <Style x:Key="StatusCaption" TargetType="Label">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="TextColor" Value="{StaticResource Ink3}" />
        <Setter Property="CharacterSpacing" Value="0.76" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- .status b: the value inside an instrument cell, 13 / mono -->
    <Style x:Key="StatusValue" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <!-- ── data rows ─────────────────────────────────────────────────────── -->

    <Style x:Key="RowLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextColor" Value="{StaticResource Ink2}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowValue" BasedOn="{StaticResource MonoValue}" TargetType="Label" />

    <!-- A value the user can write. Same monospaced number as a read-only row, in a field the
         keyboard can type it with: no border, no fill, no second visual weight on a screen that
         is already a list of numbers. What the field accepts is not here — that is the field's
         type, which the row knows and this style does not. -->
    <Style x:Key="RowValueField" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Ink3}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="WidthRequest" Value="96" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="ClearButtonVisibility" Value="Never" />
        <Setter Property="ReturnType" Value="Done" />
    </Style>

    <Style x:Key="RowValueMuted" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Ink2}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowAction" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Ink3}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- unit next to a number: 10.5, Ink3 -->
    <Style x:Key="Unit" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{StaticResource Ink3}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- ── buttons ───────────────────────────────────────────────────────── -->

    <!-- .btn: the primary action, accent-filled -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- .btn.ghost: secondary, outline only -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Line2}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- .steppers button: the −/+ pair -->
    <Style x:Key="StepperButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Panel2}" />
        <Setter Property="TextColor" Value="{StaticResource Ink2}" />
        <Setter Property="BorderColor" Value="{StaticResource Line2}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="WidthRequest" Value="26" />
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="26" />
        <Setter Property="MinimumHeightRequest" Value="26" />
    </Style>

    <!-- ── surfaces ──────────────────────────────────────────────────────── -->

    <!-- .status / .alert / .writebar: a panel with a hairline border -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Panel}" />
        <Setter Property="Stroke" Value="{StaticResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

</ResourceDictionary>
