<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tokens copied verbatim from the accepted mock-up ui/prototype/index.html.
         Everything is a multiple of 8 px. Two levels of text, one line, one accent.
         Red stays only where the original had it: the primary action. -->

    <Color x:Key="Bg">#08090B</Color>
    <!-- The phone screen in the mock-up is a shade lighter than the page behind it -->
    <Color x:Key="Screen">#0B0C0E</Color>
    <Color x:Key="Panel">#111316</Color>
    <Color x:Key="Panel2">#16191D</Color>
    <Color x:Key="Line">#24272D</Color>
    <Color x:Key="Line2">#31353C</Color>

    <Color x:Key="Ink">#EDEFF2</Color>
    <Color x:Key="Ink2">#8B929B</Color>
    <Color x:Key="Ink3">#5B6169</Color>

    <Color x:Key="Accent">#E0301E</Color>
    <Color x:Key="Ok">#49B98A</Color>
    <Color x:Key="Warn">#E0A32E</Color>

    <!-- rgba(224,48,30,.10): the background of a selected group or style -->
    <Color x:Key="AccentTint">#1AE0301E</Color>

    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Overlaid on video frames and on the live view -->
    <Color x:Key="OverlayInk">#E7EAEE</Color>
    <Color x:Key="BadgeInk">#0B0C0E</Color>
    <Color x:Key="BadgeBg">#C9CED4</Color>

</ResourceDictionary>
